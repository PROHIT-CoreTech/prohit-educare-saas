# PROHIT Educare Multi-Tenant SaaS - Unified Environment Template

# 1. MongoDB Database Connection URL
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/educare-dev?retryWrites=true&w=majority
MONGO_URI_DEVELOPMENT=mongodb+srv://<username>:<password>@cluster0.mongodb.net/educare-dev?retryWrites=true&w=majority
DATABASE_NAME=educare-dev

# 2. Backend Server Configuration (NestJS)
PORT=4000
NODE_ENV=development
API_PREFIX=api
BACKEND_URL=http://localhost:4000

# 3. Frontend Web Application Configuration (Next.js 14)
NEXT_PUBLIC_APP_DOMAIN=educare.prohitcoretech.com
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Authentication & Security Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d
PLATFORM_JWT_SECRET=your_master_admin_jwt_secret

# 5. Cashfree Subscription & Payment Gateway Keys
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
CASHFREE_ENV=SANDBOX
NEXT_PUBLIC_CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
NEXT_PUBLIC_CASHFREE_ENV=SANDBOX

# 6. Seed Master Admin Credentials
SEED_MASTER_ADMIN_EMAIL=admin@prohiteducare.com
SEED_MASTER_ADMIN_PASSWORD=AdminPassword123!
